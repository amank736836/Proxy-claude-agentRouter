AGENT_ROUTER_API_KEY=your_agent_router_api_key_here
AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1
AGENT_ROUTER_MODEL=claude-sonnet-4-6

# ─── Rate limiting (adjust to match your Agent Router quota) ────────────────
# Max outgoing requests per rolling 60s window. Lower this if you're getting
# 429s; raise it only if your Agent Router quota supports it.
AGENT_ROUTER_RPM_LIMIT=40

# How long a single Claude Code request will queue (sleep) waiting for a slot
# before the proxy returns HTTP 429 to the client. Keeps Claude Code from
# hanging indefinitely during a burst.
AGENT_ROUTER_RPM_MAX_WAIT_MS=8000

# If Agent Router still returns 429 despite the local cap (e.g. shared tenant spike),
# pause the local limiter for this many ms and reject incoming requests with
# 429 + Retry-After instead of queueing against a known-bad endpoint.
AGENT_ROUTER_RPM_429_BACKOFF_MS=15000

# ─── Network binding ────────────────────────────────────────────────────────
# The proxy listens on 127.0.0.1 only by default, because it has no client auth
# and holds your Agent Router API key. Only set this to 0.0.0.0 if you
# understand that anyone who can reach the port can use your key.
# AGENT_ROUTER_HOST=127.0.0.1
